{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PROVIEW CCTV",
  "version": "0.4.0",
  "identifier": "io.zhafron.proview-cctv",
  "build": {
    "frontendDist": "../apps/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../apps/web",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm ci --include=dev && npm run build",
      "cwd": "../apps/web"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Watch PROVIEW CCTV cameras from the desktop",
    "longDescription": "A native shell around the PROVIEW CCTV engine: cloud and LAN device access, live view, and recordings, without exposing a network port.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3"
    }
  }
}
